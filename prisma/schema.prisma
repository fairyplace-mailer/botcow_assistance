generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model KvItem {
  key       String   @id
  valueJson Json
  expiresAt DateTime?
  updatedAt DateTime @updatedAt
}

model GithubCache {
  key          String   @id
  responseJson Json
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
}

model CrawlJob {
  id            String    @id @default(cuid())
  kind          String
  startedAt     DateTime
  finishedAt    DateTime?
  status        String
  batchLimit    Int?
  processed     Int?
  inserted      Int?
  updated       Int?
  deleted       Int?
  skipped       Int?
  errorsJson    Json?
  metaJson      Json?

  createdAt     DateTime  @default(now())

  @@index([kind, startedAt])
  @@index([status])
}

model CronLock {
  name         String   @id
  lockedAt     DateTime
  lockedUntil  DateTime
  metaJson     Json?
}

model DocPage {
  id          String   @id @default(cuid())
  url         String   @unique
  title       String?
  text        String
  contentHash String

  httpStatus  Int?

  fetchedAt   DateTime
  lastSeenAt  DateTime

  // Refresh cadence (see docs/wix_spec.md): daily-ish updates.
  refreshIntervalHours Int      @default(24)
  nextFetchAt          DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chunks DocChunk[]

  @@index([fetchedAt])
  @@index([lastSeenAt])
  @@index([nextFetchAt])
}

model DocChunk {
  id             String   @id @default(cuid())
  pageId         String
  idx            Int
  content        String

  // pgvector embedding
  // NOTE: requires `CREATE EXTENSION vector;` in Postgres (Neon supports it)
  embedding      Unsupported("vector(3072)")?
  embeddingModel String?
  dims           Int?

  createdAt      DateTime @default(now())

  page DocPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, idx])
  @@index([pageId])
}

// ----------------------
// External Web Knowledge Base (curated crawl + incremental updates)
// ----------------------

model WebSite {
  id        String   @id @default(cuid())
  domain    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages WebPage[]
}

model WebPage {
  id                   String   @id @default(cuid())
  siteId               String
  url                  String   @unique
  title                String?
  httpStatus           Int?
  excludedReason       String?

  contentHash          String?
  fetchedAt            DateTime?
  lastSeenAt           DateTime?

  // Refresh cadence:
  //  - 24h for pricing/shipping/policies etc
  //  - 480h (20d) for static pages
  refreshIntervalHours Int      @default(480)
  nextFetchAt          DateTime?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  site   WebSite   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  chunks WebChunk[]

  @@index([siteId, nextFetchAt])
  @@index([fetchedAt])
  @@index([lastSeenAt])
}

model WebChunk {
  id             String   @id @default(cuid())
  pageId         String
  idx            Int
  content        String

  // pgvector embedding
  embedding      Unsupported("vector(3072)")?
  embeddingModel String?
  dims           Int?

  createdAt      DateTime @default(now())

  page WebPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, idx])
  @@index([pageId])
}
