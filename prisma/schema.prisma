generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model KvItem {
  key       String   @id
  valueJson Json
  expiresAt DateTime?
  updatedAt DateTime @updatedAt
}

model DocPage {
  id          String   @id @default(cuid())
  url         String   @unique
  title       String?
  text        String
  contentHash String
  fetchedAt   DateTime
  lastSeenAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chunks DocChunk[]

  @@index([fetchedAt])
  @@index([lastSeenAt])
}

model DocChunk {
  id             String   @id @default(cuid())
  pageId         String
  idx            Int
  content        String
  embeddingJson  Json?
  embeddingModel String?
  dims           Int?
  createdAt      DateTime @default(now())

  page DocPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, idx])
  @@index([pageId])
}
