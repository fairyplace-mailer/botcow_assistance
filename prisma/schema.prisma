generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum KnowledgeSourceStatus {
  active
  disabled
}

enum KnowledgeJobStatus {
  queued
  running
  paused
  done
  failed
}

enum KnowledgeDocumentStatus {
  pending
  fetched
  extracted
  embedded
  ready
  failed
  deleted
}

model KvItem {
  key       String   @id
  valueJson Json
  expiresAt DateTime?
  updatedAt DateTime @updatedAt
}

model GithubCache {
  key          String   @id
  responseJson Json
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
}

model CronLock {
  name         String   @id
  lockedAt     DateTime
  lockedUntil  DateTime
  metaJson     Json?
}

model KnowledgeSource {
  id               String                @id @default(cuid())
  sourceKey        String                @unique @map("source_key")
  sourceKind       String                @map("source_kind")
  seedManifestPath String                @map("seed_manifest_path")
  scopeAllowlist   String                @map("scope_allowlist")
  status           KnowledgeSourceStatus @default(active)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  jobs      KnowledgeJob[]
  documents KnowledgeDocument[]

  @@map("knowledge_sources")
}

model KnowledgeJob {
  id           String             @id @default(cuid())
  sourceId     String             @map("source_id")
  jobKind      String             @map("job_kind")
  jobStatus    KnowledgeJobStatus @default(queued) @map("job_status")
  batchLimit   Int?               @map("batch_limit")
  cursor       String?            @map("cursor")
  processed    Int                @default(0)
  inserted     Int                @default(0)
  updated      Int                @default(0)
  skipped      Int                @default(0)
  errorCount   Int                @default(0) @map("error_count")
  lastError    String?            @db.Text @map("last_error")
  startedAt    DateTime           @default(now()) @map("started_at")
  finishedAt   DateTime?          @map("finished_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, jobKind, createdAt])
  @@index([jobStatus])
  @@map("knowledge_jobs")
}

model KnowledgeDocument {
  id                 String                  @id @default(cuid())
  sourceId           String                  @map("source_id")
  originalUrl        String                  @map("original_url")
  canonicalUrl       String                  @map("canonical_url")
  sourceSection      String?                 @map("source_section")
  title              String?
  normalizedMarkdown String?                 @db.Text @map("normalized_markdown")
  contentHash        String?                 @map("content_hash")
  lastHttpStatus     Int?                    @map("last_http_status")
  documentStatus     KnowledgeDocumentStatus @default(pending) @map("document_status")
  fetchedAt          DateTime?               @map("fetched_at")
  embeddedAt         DateTime?               @map("embedded_at")
  lastError          String?                 @db.Text @map("last_error")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")

  source KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  chunks KnowledgeChunk[]

  @@index([sourceId, documentStatus])
  @@unique([sourceId, canonicalUrl])
  @@index([canonicalUrl])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id           String            @id @default(cuid())
  documentId   String            @map("document_id")
  chunkVersion Int               @default(1) @map("chunk_version")
  chunkIndex   Int               @map("chunk_index")
  isActive     Boolean           @default(true) @map("is_active")
  chunkText    String            @db.Text @map("chunk_text")
  tokenCount   Int               @map("token_count")
  textHash     String            @map("text_hash")
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkVersion, chunkIndex])
  @@index([documentId])
  @@index([documentId, isActive])
  @@map("knowledge_chunks")
}
