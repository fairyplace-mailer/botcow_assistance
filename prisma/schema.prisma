generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model KvItem {
  key       String   @id
  valueJson Json
  expiresAt DateTime?
  updatedAt DateTime @updatedAt
}

model GithubCache {
  key          String   @id
  responseJson Json
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
}

model CrawlJob {
  id            String    @id @default(cuid())
  kind          String
  startedAt     DateTime
  finishedAt    DateTime?
  status        String
  batchLimit    Int?
  processed     Int?
  inserted      Int?
  updated       Int?
  deleted       Int?
  skipped       Int?
  errorsJson    Json?
  metaJson      Json?

  createdAt     DateTime  @default(now())

  @@index([kind, startedAt])
  @@index([status])
}

model DocPage {
  id          String   @id @default(cuid())
  url         String   @unique
  title       String?
  text        String
  contentHash String
  blobPath    String?
  fetchedAt   DateTime
  lastSeenAt  DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chunks DocChunk[]

  @@index([fetchedAt])
  @@index([lastSeenAt])
}

model DocChunk {
  id             String   @id @default(cuid())
  pageId         String
  idx            Int
  content        String

  // pgvector embedding
  // NOTE: requires `CREATE EXTENSION vector;` in Postgres (Neon supports it)
  embedding      Unsupported("vector(3072)")?
  embeddingModel String?
  dims           Int?

  createdAt      DateTime @default(now())

  page DocPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, idx])
  @@index([pageId])
}
