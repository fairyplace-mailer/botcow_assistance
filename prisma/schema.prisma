generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum KnowledgeLayer {
  OFFICIAL
  TEMPORARY
}

model KvItem {
  key       String   @id
  valueJson Json
  expiresAt DateTime?
  updatedAt DateTime @updatedAt
}

model GithubCache {
  key          String   @id
  responseJson Json
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([expiresAt])
}

model CrawlJob {
  id            String    @id @default(cuid())
  kind          String
  startedAt     DateTime
  finishedAt    DateTime?
  status        String
  batchLimit    Int?
  processed     Int?
  inserted      Int?
  updated       Int?
  deleted       Int?
  skipped       Int?
  errorsJson    Json?
  metaJson      Json?

  createdAt     DateTime  @default(now())

  @@index([kind, startedAt])
  @@index([status])
}

model CronLock {
  name         String   @id
  lockedAt     DateTime
  lockedUntil  DateTime
  metaJson     Json?
}

model DocPage {
  id          String         @id @default(cuid())
  url         String         @unique
  title       String?
  text        String
  contentHash String
  knowledgeLayer KnowledgeLayer @default(OFFICIAL)
  retentionUntil DateTime?
  lastAccessedAt DateTime?
  retentionReason String?

  httpStatus  Int?

  fetchedAt   DateTime
  lastSeenAt  DateTime

  refreshIntervalHours Int      @default(24)
  nextFetchAt          DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chunks DocChunk[]

  @@index([fetchedAt])
  @@index([lastSeenAt])
  @@index([nextFetchAt])
  @@index([knowledgeLayer, retentionUntil])
}

model DocChunk {
  id             String         @id @default(cuid())
  pageId         String
  idx            Int
  content        String
  knowledgeLayer KnowledgeLayer @default(OFFICIAL)
  retentionUntil DateTime?
  lastAccessedAt DateTime?

  embedding      Unsupported("vector(3072)")?
  embeddingModel String?
  dims           Int?

  createdAt      DateTime @default(now())

  page DocPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, idx])
  @@index([pageId])
  @@index([knowledgeLayer, retentionUntil])
}
